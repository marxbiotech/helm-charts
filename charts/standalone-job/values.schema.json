{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "runId": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "nameOverride": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "ttlSecondsAfterFinished": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "activeDeadlineSeconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "hook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "pre-install",
                  "post-install",
                  "pre-delete",
                  "post-delete",
                  "pre-upgrade",
                  "post-upgrade",
                  "pre-rollback",
                  "post-rollback"
                ]
              }
            },
            "weight": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "deletePolicy": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "before-hook-creation",
                  "hook-succeeded",
                  "hook-failed"
                ]
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resources": {
      "type": "object"
    },
    "restartPolicy": {
      "type": "string",
      "enum": [
        "Never",
        "OnFailure"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "description": "Global values passed from a parent chart"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "job"
        ],
        "properties": {
          "job": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "job": {
            "anyOf": [
              {
                "required": [
                  "runId"
                ],
                "properties": {
                  "runId": {
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "nameOverride"
                ],
                "properties": {
                  "nameOverride": {
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "image": {
            "required": [
              "repository"
            ],
            "properties": {
              "repository": {
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "tag"
                ],
                "properties": {
                  "tag": {
                    "minLength": 1
                  }
                }
              },
              {
                "required": [
                  "digest"
                ],
                "properties": {
                  "digest": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
